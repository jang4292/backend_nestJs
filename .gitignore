# Dependencies
node_modules/
.npm/

# Build output
dist/
*.tsbuildinfo

# Logs (app, npm, pm2)
logs/
*.log
npm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
.pm2/

# Runtime data
pids/
*.pid
*.pid.lock

# Test coverage
coverage/
*.lcov
.nyc_output/

# Tool caches
.eslintcache
.cache/
.node_repl_history
*.tgz

# Environment variables (only *.example files are committed)
.env
.env.*
!.env.example
!.env.*.example
/deploy/*.env
!/deploy/*.env.example

# Keys, certificates, credentials
# (config/global-bundle.pem: AWS RDS public CA bundle, downloaded per host)
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_rsa.pub
*serviceAccountKey.json
*service-account*.json
*firebase-adminsdk*.json

# Local runtime files
tmp/
uploads/

# DB dumps and backups (사용자 데이터·비밀번호 해시 포함. 저장소 밖에 보관: docs/learning/database-improvement-guide.kr.md)
*.sql
*.sql.gz
*.dump

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code personal settings (shared settings live in .claude/settings.json)
.claude/settings.local.json
