# Copy to /etc/backend-nestjs/backend-nestjs.env on EC2. Do not store this file in Git.
NODE_ENV=production
PORT=3000

DB_TYPE=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=replace-with-production-db-user
DB_PASSWORD=replace-with-production-db-password
DB_DATABASE=replace-with-production-db-name
DB_SYNCHRONIZE=false
# Current MariaDB: have_ssl=Disabled and require_secure_transport=OFF.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=replace-with-a-strong-production-secret
JWT_EXPIRES_IN=1h
THROTTLE_TTL=60
THROTTLE_LIMIT=10
CORS_ORIGIN=https://replace-with-frontend-origin

GOOGLE_ALLOWED_AUDIENCES=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_ISSUERS=accounts.google.com,https://accounts.google.com
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URIS=https://replace-with-app-origin/auth/google/callback

# Optional social providers. Replace every placeholder for each provider used
# by the client application.
# APPLE_ALLOWED_AUDIENCES=replace-with-apple-audience
# APPLE_SERVICE_ID=replace-with-apple-service-id
# APPLE_TEAM_ID=replace-with-apple-team-id
# APPLE_KEY_ID=replace-with-apple-key-id
# APPLE_PRIVATE_KEY=replace-with-apple-private-key
# APPLE_REDIRECT_URIS=https://replace-with-app-origin/auth/apple/callback
# FACEBOOK_APP_ID=replace-with-facebook-app-id
# FACEBOOK_APP_SECRET=replace-with-facebook-app-secret
# FACEBOOK_REDIRECT_URIS=https://replace-with-app-origin/auth/facebook/callback
# FACEBOOK_GRAPH_API_VERSION=v20.0
# KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
# KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
# KAKAO_REDIRECT_URIS=https://replace-with-app-origin/auth/kakao/callback
# NAVER_CLIENT_ID=replace-with-naver-client-id
# NAVER_CLIENT_SECRET=replace-with-naver-client-secret
# NAVER_REDIRECT_URIS=https://replace-with-app-origin/auth/naver/callback