# 이 파일은 로컬 개발 환경 설정 템플릿입니다.
# 복사해서 .env로 만든 뒤 실제 로컬 값을 입력하세요.
# .env 파일은 Git에 커밋하지 않으며, 비밀번호와 secret은 이 파일에 기록하지 않습니다.

# 애플리케이션 서버 설정
# HTTP 서버가 수신할 포트입니다.
PORT=3000
# 실행 환경입니다. 개발 환경에서는 development를 사용합니다.
# test는 .env.test.local, production은 배포 환경변수 또는 Secrets Manager를 사용합니다.
NODE_ENV=development

# 데이터베이스 연결 설정
# 현재 애플리케이션은 MariaDB만 지원합니다.
DB_TYPE=mariadb
# MariaDB 호스트 주소입니다. 로컬 DB라면 localhost 또는 127.0.0.1을 사용합니다.
DB_HOST=yhjang.com
# MariaDB 기본 포트입니다.
DB_PORT=3306
# 데이터베이스에 접속할 사용자 이름입니다. 실제 로컬 계정으로 변경하세요.
DB_USERNAME=replace-with-local-db-user
# 데이터베이스 비밀번호입니다. 실제 비밀번호를 입력하고 Git에 커밋하지 마세요.
DB_PASSWORD=replace-with-local-db-password
# 개발 환경에서 사용할 데이터베이스 이름입니다.
DB_DATABASE=nestjs_db
# TypeORM이 시작할 때 테이블을 자동으로 변경할지 여부입니다.
# 공유 DB나 운영 DB에서는 반드시 false로 유지하고 migration을 사용하세요.
DB_SYNCHRONIZE=false
# 현재 MariaDB 서버의 SSL 상태에 맞춘 설정입니다.
# 서버에서 SSL을 사용하지 않는 경우 false로 둡니다.
DB_SSL=false
# DB_SSL=true일 때 서버 인증서를 검증할지 여부입니다.
# 운영에서는 true를 권장하며, 신뢰할 수 있는 CA 인증서가 필요합니다.
DB_SSL_REJECT_UNAUTHORIZED=true
# 운영에서 DB_SSL=true이고 인증서 검증도 true이면 CA 인증서 경로가 필요합니다.
# 현재 로컬 MariaDB에서는 보통 비워 둡니다.
# DB_SSL_CA=/app/config/rds-ca-bundle.pem
# 선택 사항: 데이터베이스 커넥션 풀 크기와 연결 제한 시간입니다.
# 값이 필요한 경우 주석을 제거하고 환경에 맞게 조정하세요.
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=5000
# 선택 사항: DB_* 변수 대신 하나의 연결 문자열을 사용할 수 있습니다.
# DATABASE_URL이 설정되면 개별 DB_* 연결 정보보다 우선 적용됩니다.
# DATABASE_URL=mariadb://username:password@hostname:3306/database

# 배포 도구용 설정
# NestJS 애플리케이션이 직접 읽는 값이 아니라 Secrets Manager export 스크립트에서 사용합니다.
# 로컬 개발에서는 보통 설정하지 않습니다.
# AWS_SECRET_ID=prod/backend-nestjs
# AWS_REGION=ap-northeast-2

# JWT 인증 설정
# JWT 토큰 서명에 사용하는 비밀 키입니다.
# 반드시 충분히 강한 로컬 전용 값을 사용하고 운영 secret과 공유하지 마세요.
JWT_SECRET=your-secret-key-change-this-in-production
# 발급된 JWT의 만료 시간입니다. 예: 1h, 30m, 7d
JWT_EXPIRES_IN=1h

# API 보안 및 요청 제한 설정
# THROTTLE_TTL 동안 동일 기준으로 허용할 최대 요청 수입니다.
# 예: 60초 동안 10회 요청 허용
THROTTLE_TTL=60
THROTTLE_LIMIT=10
# 브라우저에서 API 호출을 허용할 프론트엔드 주소입니다.
# 여러 주소가 필요한 경우 프로젝트의 CORS 처리 방식에 맞춰 설정하세요.
CORS_ORIGIN=http://localhost:3001

# Google OAuth 및 SNS 로그인 설정
# ID Token의 aud 값 검증에 사용하는 Google Client ID입니다.
# 애플리케이션 시작 시 필수입니다.
# 아직 Client ID를 발급받지 않았다면 아래 placeholder를 유지할 수 있지만,
# 이 상태에서는 Google 로그인 기능을 사용할 수 없습니다.
# 발급 후 실제 Google Client ID로 반드시 교체하세요.
GOOGLE_ALLOWED_AUDIENCES=your-google-client-id.apps.googleusercontent.com
# ID Token의 iss 값 검증에 허용할 발급자 목록입니다.
# 쉼표로 여러 값을 구분할 수 있습니다.
GOOGLE_ALLOWED_ISSUERS=accounts.google.com,https://accounts.google.com
# Authorization Code 교환 방식에 필요한 설정입니다.
# Native/Android/iOS 로그인 흐름을 사용하지 않으면 비워 둘 수 있습니다.
# 사용한다면 동일한 OAuth Client 설정을 Google Cloud Console에서 확인하세요.
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URIS=https://your-app.example.com/auth/google/callback
