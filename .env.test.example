# 로컬 E2E 테스트 설정 템플릿입니다.
# 이 파일을 .env.test.local로 복사한 뒤 테스트 전용 계정 정보를 입력하세요.
# 실제 비밀번호와 secret은 이 파일에 기록하거나 커밋하지 마세요.

# 애플리케이션 서버 포트
PORT=3000
# 테스트 환경으로 동작하도록 지정합니다.
NODE_ENV=test

# 테스트 데이터베이스 연결 정보
# 개발/운영 데이터베이스와 분리된 테스트 전용 DB를 사용해야 합니다.
DB_TYPE=mariadb
DB_HOST=yhjang.com
DB_PORT=3306
DB_USERNAME=replace-with-test-db-user
DB_PASSWORD=replace-with-test-db-password
# 현재 테스트 계정이 접근 가능한 데이터베이스입니다.
# 현재는 app_db를 임시 사용하며, 전용 테스트 DB가 준비되면 app_db_test로 변경하세요.
DB_DATABASE=app_db
# TypeORM이 스키마를 자동 변경하지 않도록 비활성화합니다.
# 테스트 DB 스키마 변경은 migration으로 관리합니다.
DB_SYNCHRONIZE=false
# 현재 MariaDB 서버의 SSL 설정에 맞춘 값입니다.
# 현재 서버는 have_ssl=Disabled, require_secure_transport=OFF입니다.
DB_SSL=false
# DB_SSL=true일 때 인증서 검증 여부입니다.
DB_SSL_REJECT_UNAUTHORIZED=true

# 테스트에서 사용할 JWT 서명 키와 토큰 만료 시간
# 운영 환경의 JWT_SECRET과 절대 공유하지 마세요.
JWT_SECRET=replace-with-a-local-test-secret
JWT_EXPIRES_IN=1h

# API 요청 제한 설정
# 짧은 시간 동안 허용할 최대 요청 수를 지정합니다.
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# 테스트 서버에서 허용할 프론트엔드 출처
CORS_ORIGIN=http://localhost:3001

# Google 로그인 테스트 설정
# 아직 Google Client ID가 없다면 placeholder를 유지하세요.
# 이 상태에서는 Google 로그인 E2E 테스트를 실행할 수 없습니다.
# 발급 후 테스트용 Google OAuth Client ID로 교체하세요.
GOOGLE_ALLOWED_AUDIENCES=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_ISSUERS=accounts.google.com,https://accounts.google.com