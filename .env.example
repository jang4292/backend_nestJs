# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=nestjs_db
# Keep false by default. Use migrations for shared/prod databases.
DB_SYNCHRONIZE=false
# Enable TLS for AWS RDS. Keep true for production unless your network policy says otherwise.
DB_SSL=false
# Set false only when the RDS CA certificate is not available to the runtime.
DB_SSL_REJECT_UNAUTHORIZED=true
# Path to AWS RDS CA bundle file (required in production when DB_SSL=true and rejectUnauthorized=true)
# DB_SSL_CA=/app/config/rds-ca-bundle.pem
# Optional PostgreSQL pool and timeout tuning
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=5000
# Optional alternative to the DB_* variables. DATABASE_URL takes precedence when set.
# DATABASE_URL=postgresql://username:password@hostname:5432/database

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=1h

# Security
THROTTLE_TTL=60
THROTTLE_LIMIT=10
CORS_ORIGIN=http://localhost:3001

# Google OAuth (SNS Login)
GOOGLE_ALLOWED_AUDIENCES=your-google-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_ISSUERS=accounts.google.com,https://accounts.google.com
# Auth-code exchange (required for Native/Android/iOS flows)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URIS=https://your-app.example.com/auth/google/callback
