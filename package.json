{
  "name": "backend_nestJs",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "secrets:export": "node scripts/export-secrets-env.cjs",
    "env:check": "node scripts/check-env.cjs development",
    "env:check:test": "node scripts/check-env.cjs test",
    "env:check:prod": "node scripts/check-env.cjs production",
    "db:check": "node scripts/typeorm-env.cjs development db:check",
    "db:setup": "node scripts/typeorm-env.cjs development db:ensure && node scripts/typeorm-env.cjs development migration:run",
    "db:check:test": "node scripts/typeorm-env.cjs test db:check",
    "db:setup:test": "node scripts/typeorm-env.cjs test db:ensure && node scripts/typeorm-env.cjs test migration:run",
    "db:reset:test": "node scripts/typeorm-env.cjs test db:reset && node scripts/typeorm-env.cjs test migration:run",
    "db:check:prod": "node scripts/typeorm-env.cjs production db:check --dist",
    "pm2:reload": "pm2 startOrReload ecosystem.config.cjs --update-env",
    "migration:generate": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:run": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:show": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "migration:show:test": "node scripts/typeorm-env.cjs test migration:show",
    "migration:run:test": "node scripts/typeorm-env.cjs test migration:run",
    "migration:revert:test": "node scripts/typeorm-env.cjs test migration:revert",
    "migration:check:test": "node scripts/typeorm-env.cjs test migration:check",
    "migration:show:prod": "node scripts/typeorm-env.cjs production migration:show --dist",
    "migration:run:prod": "node scripts/typeorm-env.cjs production migration:run --dist",
    "migration:revert:prod": "node scripts/typeorm-env.cjs production migration:revert --dist",
    "docs:html": "node docs/html/_tools/build.mjs",
    "docs:html:verify": "node docs/html/_tools/build.mjs --verify",
    "docs:html:status": "node docs/html/_tools/build.mjs --status",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.10",
    "mysql2": "^3.24.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "marked": "^18.1.2",
    "prettier": "^3.7.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
