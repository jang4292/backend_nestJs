# ------------------------------------------------------------------
# [Production] EC2 운영 서버용 템플릿 → 서버의 프로젝트 루트에서 .env.production 으로 복사합니다.
#   cp .env.production.example .env.production && chmod 600 .env.production
# PM2(ecosystem.config.cjs)가 NODE_ENV=production으로 실행하면 앱이 이 파일을 읽습니다.
# migration도 같은 파일을 사용합니다: npm run build && npm run migration:run:prod
# .env.production 은 Git에 커밋하지 않습니다. 비밀번호·secret은 서버에서만 입력합니다.
# 아래 replace-with-… 값은 그대로 두면 기동이 실패하도록 되어 있습니다(의도된 안전장치).
# ------------------------------------------------------------------

NODE_ENV=production
PORT=3000
# 같은 호스트의 reverse proxy(nginx 등)만 신뢰합니다. proxy가 없어도 안전한 기본값입니다.
# (클라이언트가 직접 접속하면 X-Forwarded-For를 무시합니다.) ALB 등 외부 proxy라면 hop 수로 바꿉니다.
TRUST_PROXY=loopback

# 데이터베이스: 같은 EC2의 MariaDB (외부에 3306을 열지 않습니다)
DB_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=replace-with-production-db-user
DB_PASSWORD=replace-with-production-db-password
DB_DATABASE=replace-with-production-db-name
# 운영에서 true는 기동 단계에서 거부됩니다. 스키마는 migration:run:prod로만 변경합니다.
DB_SYNCHRONIZE=false
# localhost 연결이므로 TLS를 사용하지 않습니다.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECT_TIMEOUT_MS=10000
DB_POOL_MAX=10

# JWT: 32자 이상의 무작위 값으로 교체하세요. 예) openssl rand -base64 48
# placeholder 문구(replace-with/change-this/your-)가 남아 있거나 32자 미만이면 기동이 실패합니다.
JWT_SECRET=replace-with-a-strong-production-secret
JWT_EXPIRES_IN=1h

THROTTLE_TTL=60
THROTTLE_LIMIT=10
# 브라우저 프론트엔드가 있으면 origin 목록(쉼표 구분)으로 바꿉니다. 없으면 none으로 CORS를 끕니다.
CORS_ORIGIN=none

# SNS 로그인 — 현재 전부 비활성(로컬 로그인만 운영)
# 다시 켜기 전에 docs/auth/sns-reenable-checklist.kr.md의 체크리스트를 완료하세요.
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
AUTH_KAKAO_ENABLED=false
AUTH_NAVER_ENABLED=false
AUTH_FACEBOOK_ENABLED=false
AUTH_NAVER_ACCESS_TOKEN_LOGIN_ENABLED=false
