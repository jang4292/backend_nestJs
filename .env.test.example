# ------------------------------------------------------------------
# [Test] e2e 테스트용 템플릿 → 복사해서 .env.test.local 로 사용합니다.
#   cp .env.test.example .env.test.local
# NODE_ENV=test 에서는 이 파일이 반드시 있어야 하며, DB 이름은 *_test 만 허용됩니다.
# (개발 DB app_db 를 e2e가 변경하지 않도록 하기 위함입니다.)
# 준비: DB_* 와 DB_PASSWORD 입력 → npm run db:setup:test(없으면 생성 + migration) → npm run test:e2e
# 빈 DB에서 전체 재검증: npm run db:reset:test (*_test DB만 허용)
# 계정·권한 SQL: docs/deployment/database-environments.kr.md (2.1, 3장)
# ------------------------------------------------------------------

PORT=3000
NODE_ENV=test
TRUST_PROXY=false

# 테스트 DB: 개발 서버의 별도 데이터베이스(개발 계정을 같이 쓰거나 전용 계정 사용)
DB_TYPE=mariadb
DB_HOST=dev-db.example.com
DB_PORT=3306
DB_USERNAME=ec2-user
# 비밀번호는 이 줄에 직접 입력합니다(채팅·문서·커밋에 남기지 않음).
DB_PASSWORD=Wp8875xx!@
DB_DATABASE=app_db_test
DB_SYNCHRONIZE=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# 운영 JWT_SECRET과 절대 공유하지 마세요.
JWT_SECRET=replace-with-a-local-test-secret-32-chars
JWT_EXPIRES_IN=1h

# 테스트는 요청 제한에 걸리지 않도록 넉넉하게 둡니다.
THROTTLE_TTL=60
THROTTLE_LIMIT=1000
CORS_ORIGIN=http://localhost:3001

# SNS 로그인 비활성(로컬 로그인만 테스트)
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
AUTH_KAKAO_ENABLED=false
AUTH_NAVER_ENABLED=false
AUTH_FACEBOOK_ENABLED=false
AUTH_NAVER_ACCESS_TOKEN_LOGIN_ENABLED=false
