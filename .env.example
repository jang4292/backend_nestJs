# ------------------------------------------------------------------
# [Development] 개발 PC용 템플릿 → 복사해서 .env 로 사용합니다.
#   cp .env.example .env
# 외부 개발 DB 서버(도메인:포트)에 직접 접속하는 구성입니다.
# 처음 연결: DB_* 와 DB_PASSWORD 입력 → npm run db:check → npm run db:setup → npm run start:dev
# .env 는 Git에 커밋하지 않습니다(.gitignore). 실제 비밀번호는 이 템플릿에 적지 않습니다.
#
# 환경별 파일 규칙 (src/config/env-files.ts)
#   NODE_ENV=development(기본) → .env
#   NODE_ENV=test               → .env.test.local   (템플릿: .env.test.example)
#   NODE_ENV=production         → .env.production   (템플릿: .env.production.example)
#   ENV_FILE=<경로> 를 지정하면 위 규칙 대신 그 파일 하나만 읽습니다.
#   이미 export된 셸 환경변수는 파일 값보다 우선합니다.
# ------------------------------------------------------------------

# 애플리케이션
PORT=3000
NODE_ENV=development
# 개발 PC에는 proxy가 없으므로 false로 둡니다.
TRUST_PROXY=false

# 데이터베이스 (외부 개발 서버)
# MariaDB만 지원합니다.
DB_TYPE=mariadb
# 개발 DB 서버 도메인 또는 IP. 공유기·NAS 포트포워딩이면 DB_PORT가 3306이 아닐 수 있습니다.
DB_HOST=dev-db.example.com
DB_PORT=3306
DB_USERNAME=replace-with-dev-db-user
# 비밀번호는 이 줄에 직접 입력합니다(채팅·문서·커밋에 남기지 않음). '#'이나 공백이 있으면 큰따옴표로 감쌉니다.
DB_PASSWORD=replace-with-dev-db-password
# 개발용 데이터베이스 (e2e는 별도의 *_test DB를 사용합니다)
DB_DATABASE=app_db
# 스키마는 migration으로만 변경합니다(앱 기동 시 자동 실행 없음).
#   npm run db:check  → 접속·권한·pending 확인(읽기 전용)
#   npm run db:setup  → DB가 없으면 생성 + migration 적용
DB_SYNCHRONIZE=false
# 개발 서버의 MariaDB는 TLS를 지원하지 않습니다(db:check 출력의 tls: off).
# TLS 없이 인터넷으로 접속하면 비밀번호가 평문으로 전송되므로,
# 서버 방화벽·공유기에서 DB 포트를 개발자 IP로 제한하거나 아래 SSH 터널을 사용하세요.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# 선택: 연결 제한 시간·풀 크기
# DB_CONNECT_TIMEOUT_MS=10000
# DB_POOL_MAX=10
# 선택: DB_* 대신 연결 문자열 하나로 지정할 수 있습니다(DB_USERNAME/PASSWORD/DATABASE는 여전히 필요).
# DATABASE_URL=mariadb://user:password@dev-db.example.com:3306/app_db
#
# [대안] SSH 터널로 접속하는 경우: 3306을 외부에 열지 않고 아래처럼 연결합니다.
#   ssh -N -L 13306:127.0.0.1:3306 <user>@<dev-server>
#   DB_HOST=127.0.0.1
#   DB_PORT=13306

# JWT (HS256)
# 개발용 값입니다. 운영 secret과 공유하지 마세요. production에서는 32자 이상이 필수입니다.
JWT_SECRET=replace-with-a-local-dev-secret-of-32-chars
# 3600 / 30m / 1h / 7d 형식
JWT_EXPIRES_IN=1h

# 요청 제한 / CORS
THROTTLE_TTL=60
THROTTLE_LIMIT=10
# 브라우저에서 호출하는 프론트엔드 주소(쉼표로 여러 개). '*'는 허용하지 않습니다.
# 브라우저 클라이언트가 없으면 CORS_ORIGIN=none 으로 끕니다.
CORS_ORIGIN=http://localhost:3001

# SNS 로그인 — 현재 전부 비활성(로컬 로그인만 사용)
# 꺼진 provider의 라우트는 외부 호출 없이 503 AUTH_<PROVIDER>_DISABLED를 반환하며,
# 관련 설정 키가 없어도 빌드·기동에 문제가 없습니다.
# 다시 켜기 전에 docs/auth/sns-reenable-checklist.kr.md를 확인하세요.
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
AUTH_KAKAO_ENABLED=false
AUTH_NAVER_ENABLED=false
AUTH_FACEBOOK_ENABLED=false
# Naver accessToken 로그인은 발급 앱 검증이 불가해 기본 차단합니다(code flow만 허용).
AUTH_NAVER_ACCESS_TOKEN_LOGIN_ENABLED=false

# 아래 provider 설정은 해당 AUTH_*_ENABLED=true로 켤 때만 채웁니다.
# GOOGLE_ALLOWED_AUDIENCES=your-google-client-id.apps.googleusercontent.com
# GOOGLE_ALLOWED_ISSUERS=accounts.google.com,https://accounts.google.com
# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
# GOOGLE_OAUTH_REDIRECT_URIS=https://your-app.example.com/auth/google/callback
# APPLE_ALLOWED_AUDIENCES=com.example.web
# APPLE_SERVICE_ID=com.example.web
# APPLE_TEAM_ID=your-apple-team-id
# APPLE_KEY_ID=your-apple-key-id
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APPLE_REDIRECT_URIS=https://your-app.example.com/auth/apple/callback
# KAKAO_APP_ID=123456
# KAKAO_REST_API_KEY=your-kakao-rest-api-key
# KAKAO_CLIENT_SECRET=your-kakao-client-secret
# KAKAO_REDIRECT_URIS=https://your-app.example.com/auth/kakao/callback
# NAVER_CLIENT_ID=your-naver-client-id
# NAVER_CLIENT_SECRET=your-naver-client-secret
# NAVER_REDIRECT_URIS=https://your-app.example.com/auth/naver/callback
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret
# FACEBOOK_REDIRECT_URIS=https://your-app.example.com/auth/facebook/callback
# FACEBOOK_GRAPH_API_VERSION=v20.0
